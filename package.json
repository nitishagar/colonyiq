{
  "name": "colonyiq",
  "version": "0.1.0",
  "private": true,
  "description": "ColonyIQ — phone-friendly agar colony counter (SAM-3.1 + Muse Spark pass-through)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "eval"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "npm run test:gates",
    "test:gates": "npm test --workspaces --if-present",
    "test:live": "COLONYIQ_LIVE=1 pnpm -r test:live",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
